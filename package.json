{
  "name": "quick-query",
  "version": "2.0.0",
  "description": "Cmd+C+C で選択テキストをローカル LLM (Ollama) に送る macOS メニューバーアプリ",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "build:helper": "mkdir -p resources && swiftc -O native/keywatch.swift -o resources/keywatch",
    "dev": "npm run build:helper && electron-vite dev",
    "build": "npm run build:helper && electron-vite build",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "ollama": "^0.6.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.oyakoli.quickquery",
    "productName": "Quick Query",
    "files": [
      "out/**"
    ],
    "extraResources": [
      "resources/keywatch",
      "resources/icon.png"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.png",
      "extendInfo": {
        "LSUIElement": true,
        "NSInputMonitoringUsageDescription": "Cmd+C+C を検知するためにキー入力の監視が必要です。"
      }
    }
  }
}
